# Environment Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# Embedding Model (BGE-Multilingual-Gemma2)
EMBEDDING_MODEL_NAME=BAAI/bge-multilingual-gemma2
EMBEDDING_DIMENSIONS=3584
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=8

# Chunking Configuration
CHUNK_SIZE_MIN=200
CHUNK_SIZE_MAX=1000
CHUNK_SIZE_TARGET=600
CHUNK_OVERLAP=100

# Collection Names
COLLECTION_DOCUMENTS=land_documents
COLLECTION_CHUNKS=land_chunks
